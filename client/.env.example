# Frontend environment (copy to .env for custom deployments — dev works with the
# Vite proxy, so both may be left empty).
# Base URL of the backend REST API. Leave empty to use the same origin (dev proxy).
VITE_API_URL=
# Socket.IO URL. Leave empty to use the same origin.
VITE_SOCKET_URL=

# Supabase (optional — browser client). Get these from the Supabase dashboard:
# Project Settings → API. Used for Supabase Auth / Realtime / Storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

