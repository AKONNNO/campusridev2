{
  "name": "knust-bus-tracker-server",
  "version": "1.0.0",
  "description": "KNUST Bus Tracker backend - Express + Socket.IO + PostgreSQL/PostGIS real-time campus bus tracking",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/init-db.js --seed-only",
    "sim": "node scripts/gps-simulator.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "knust",
    "bus",
    "tracker",
    "postgis",
    "socket.io",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
