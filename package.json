{
  "name": "campusride",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time campus bus tracking for KNUST (Kumasi, Ghana): live bus locations, next stops, ETAs, a nearest-stop tool, trip planner and arrival alerts for students, a mobile GPS-sharing driver app, and an admin dashboard — all in one project.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "start": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AKONNNO/campusridev2.git"
  },
  "bugs": {
    "url": "https://github.com/AKONNNO/campusridev2/issues"
  },
  "homepage": "https://github.com/AKONNNO/campusridev2#readme",
  "license": "ISC"
}
