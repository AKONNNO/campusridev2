###############################################################################
# KNUST Bus Tracker - server environment (copy to .env and fill in)
#   cp .env.example .env
###############################################################################

# ---- HTTP server ----
PORT=5000
NODE_ENV=development

# ---- PostgreSQL + PostGIS ----
# Matches docker-compose.yml defaults. Change if you run your own Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knust_bus_tracker

# ---- Auth (JWT + bcrypt PINs) ----
# Generate a long random value, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- CORS ----
# Origin(s) of the Vite dev server / deployed frontend, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Socket.IO transport tuning (weak connections) ----
SOCKET_PING_TIMEOUT=10000
SOCKET_PING_INTERVAL=8000

# ---- Supabase (optional) ----
# Full-stack Supabase integration. Get these from your Supabase project
# (Project Settings → API). Leave empty to keep using the local
# PostgreSQL/PostGIS + JWT stack.
# The service-role key is SERVER-ONLY — never ship it in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
